import React, { useState, useEffect, useRef } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import { useSocket } from '../context/SocketContext';
import api from '../services/api';
import '../styles/Rooms.css';

export default function Rooms() {
  const navigate = useNavigate();
  const { user } = useAuth();
  const { socket } = useSocket();
  const messagesEndRef = useRef(null);

  const [rooms, setRooms] = useState([]);
  const [selectedRoom, setSelectedRoom] = useState(null);
  const [messages, setMessages] = useState([]);
  const [members, setMembers] = useState([]);
  const [messageText, setMessageText] = useState('');
  const [loading, setLoading] = useState(true);
  const [showCreateModal, setShowCreateModal] = useState(false);
  const [posts, setPosts] = useState([]);
  const [newRoom, setNewRoom] = useState({ post_id: '', name: '' });

  useEffect(() => {
    fetchRooms();
    fetchPosts();
  }, []);

  useEffect(() => {
    if (selectedRoom) {
      fetchMessages(selectedRoom.id);
      fetchMembers(selectedRoom.id);
      checkMembership(selectedRoom.id);
      
      // Join socket room
      if (socket) {
        socket.emit('join-room', selectedRoom.id);
      }
    }

    return () => {
      if (selectedRoom && socket) {
        socket.emit('leave-room', selectedRoom.id);
      }
    };
  }, [selectedRoom, socket]);

  useEffect(() => {
    if (!socket) return;

    socket.on('room-message', (message) => {
      if (selectedRoom && message.room_id === selectedRoom.id) {
        setMessages(prev => [...prev, message]);
      }
    });

    return () => {
      socket.off('room-message');
    };
  }, [socket, selectedRoom]);

  useEffect(() => {
    scrollToBottom();
  }, [messages]);

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };

  const fetchRooms = async () => {
    try {
      const res = await api.get('/api/rooms');
      setRooms(res.data);
    } catch (err) {
      console.error('Failed to fetch rooms:', err);
    } finally {
      setLoading(false);
    }
  };

  const fetchPosts = async () => {
    try {
      const res = await api.get('/api/posts');
      setPosts(res.data);
    } catch (err) {
      console.error('Failed to fetch posts:', err);
    }
  };

  const fetchMessages = async (roomId) => {
    try {
      const res = await api.get(`/api/messages/${roomId}`);
      setMessages(res.data);
    } catch (err) {
      console.error('Failed to fetch messages:', err);
    }
  };

  const fetchMembers = async (roomId) => {
    try {
      const res = await api.get(`/api/rooms/${roomId}/members`);
      setMembers(res.data);
    } catch (err) {
      console.error('Failed to fetch members:', err);
    }
  };

  const checkMembership = async (roomId) => {
    try {
      const res = await api.get(`/api/rooms/${roomId}/check-membership`);
      setSelectedRoom(prev => ({ ...prev, isMember: res.data.isMember }));
    } catch (err) {
      console.error('Failed to check membership:', err);
    }
  };

  const handleCreateRoom = async (e) => {
    e.preventDefault();
    try {
      const res = await api.post('/api/rooms', newRoom);
      setRooms(prev => [...prev, res.data]);
      setShowCreateModal(false);
      setNewRoom({ post_id: '', name: '' });
      setSelectedRoom(res.data);
    } catch (err) {
      alert('Failed to create room: ' + (err.response?.data?.message || 'Error'));
    }
  };

  const handleJoinRoom = async () => {
    try {
      await api.post(`/api/rooms/${selectedRoom.id}/join`);
      setSelectedRoom(prev => ({ ...prev, isMember: true }));
      fetchMembers(selectedRoom.id);
      fetchRooms();
    } catch (err) {
      alert('Failed to join room: ' + (err.response?.data?.message || 'Error'));
    }
  };

  const handleLeaveRoom = async () => {
    try {
      await api.post(`/api/rooms/${selectedRoom.id}/leave`);
      setSelectedRoom(prev => ({ ...prev, isMember: false }));
      fetchMembers(selectedRoom.id);
      fetchRooms();
    } catch (err) {
      alert('Failed to leave room: ' + (err.response?.data?.message || 'Error'));
    }
  };

  const handleDeleteRoom = async () => {
    if (!confirm('Are you sure you want to delete this room?')) return;
    try {
      await api.delete(`/api/rooms/${selectedRoom.id}`);
      setRooms(prev => prev.filter(r => r.id !== selectedRoom.id));
      setSelectedRoom(null);
    } catch (err) {
      alert('Failed to delete room: ' + (err.response?.data?.message || 'Error'));
    }
  };

  const handleSendMessage = async (e) => {
    e.preventDefault();
    if (!messageText.trim() || !selectedRoom?.isMember) return;

    try {
      const res = await api.post(`/api/messages/${selectedRoom.id}`, {
        content: messageText
      });
      
      // Emit socket event
      if (socket) {
        socket.emit('room-message', {
          ...res.data,
          username: user.username,
          profile_picture: user.profile_picture
        });
      }
      
      setMessageText('');
    } catch (err) {
      alert('Failed to send message: ' + (err.response?.data?.message || 'Error'));
    }
  };

  const handleLogout = () => {
    localStorage.removeItem('token');
    navigate('/login');
  };

  const getInitials = (name) => {
    if (!name) return '?';
    return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
  };

  if (loading) {
    return <div className="rooms-loading">Loading...</div>;
  }

  return (
    <div className="rooms-container">
      <div className="rooms-header">
        <h1>Study Rooms</h1>
        <div className="rooms-header-actions">
          <button onClick={() => setShowCreateModal(true)} className="btn-create-room">
            + Create Room
          </button>
          <button onClick={() => navigate('/home')} className="btn-nav">Dashboard</button>
          <button onClick={() => navigate('/posts')} className="btn-nav">Posts</button>
          <button onClick={() => navigate('/friends')} className="btn-nav">Friends</button>
          <button onClick={() => navigate('/profile')} className="btn-nav">Profile</button>
          <button onClick={handleLogout} className="btn-logout">Logout</button>
        </div>
      </div>

      <div className="rooms-content">
        <div className="rooms-sidebar">
          <h2>All Rooms ({rooms.length})</h2>
          <div className="rooms-list">
            {rooms.length === 0 ? (
              <p className="no-rooms">No rooms yet. Create one!</p>
            ) : (
              rooms.map(room => (
                <div
                  key={room.id}
                  className={`room-card ${selectedRoom?.id === room.id ? 'active' : ''}`}
                  onClick={() => setSelectedRoom(room)}
                >
                  <div className="room-card-header">
                    <h3>{room.name}</h3>
                    <span className="room-members-count">{room.member_count} members</span>
                  </div>
                  <p className="room-post-title">{room.post_title}</p>
                  <div className="room-creator">
                    {room.creator_profile_picture ? (
                      <img 
                        src={`http://localhost:5000${room.creator_profile_picture}`} 
                        alt={room.creator_username}
                        className="creator-avatar"
                      />
                    ) : (
                      <div className="creator-avatar">{getInitials(room.creator_username)}</div>
                    )}
                    <span>by {room.creator_username}</span>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>

        {selectedRoom ? (
          <div className="room-main">
            <div className="room-chat">
              <div className="room-chat-header">
                <div>
                  <h2>{selectedRoom.name}</h2>
                  <p>{selectedRoom.post_title}</p>
                </div>
                <div className="room-actions">
                  {selectedRoom.isMember ? (
                    <>
                      <button onClick={handleLeaveRoom} className="btn-leave">Leave Room</button>
                      {(selectedRoom.created_by === user.id || user.role === 'PRO') && (
                        <button onClick={handleDeleteRoom} className="btn-delete">Delete Room</button>
                      )}
                    </>
                  ) : (
                    <button onClick={handleJoinRoom} className="btn-join">Join Room</button>
                  )}
                </div>
              </div>

              {selectedRoom.isMember ? (
                <>
                  <div className="room-messages">
                    {messages.length === 0 ? (
                      <p className="no-messages">No messages yet. Start the conversation!</p>
                    ) : (
                      messages.map((msg, idx) => (
                        <div key={idx} className={`message ${msg.user_id === user.id ? 'own' : ''}`}>
                          <div className="message-avatar">
                            {msg.profile_picture ? (
                              <img 
                                src={`http://localhost:5000${msg.profile_picture}`} 
                                alt={msg.username}
                              />
                            ) : (
                              <div className="avatar-initials">{getInitials(msg.username)}</div>
                            )}
                          </div>
                          <div className="message-content">
                            <div className="message-header">
                              <span className="message-username">{msg.username}</span>
                              <span className="message-time">
                                {new Date(msg.created_at).toLocaleString()}
                              </span>
                            </div>
                            <p className="message-text">{msg.content}</p>
                          </div>
                        </div>
                      ))
                    )}
                    <div ref={messagesEndRef} />
                  </div>

                  <form onSubmit={handleSendMessage} className="room-message-form">
                    <input
                      type="text"
                      value={messageText}
                      onChange={(e) => setMessageText(e.target.value)}
                      placeholder="Type a message..."
                      className="message-input"
                    />
                    <button type="submit" className="btn-send">Send</button>
                  </form>
                </>
              ) : (
                <div className="room-locked">
                  <p>Join this room to see messages and participate in discussions.</p>
                </div>
              )}
            </div>

            <div className="room-members">
              <h3>Members ({members.length})</h3>
              <div className="members-list">
                {members.map(member => (
                  <div key={member.user_id} className="member-item">
                    {member.profile_picture ? (
                      <img 
                        src={`http://localhost:5000${member.profile_picture}`} 
                        alt={member.username}
                        className="member-avatar"
                      />
                    ) : (
                      <div className="member-avatar">{getInitials(member.username)}</div>
                    )}
                    <span>{member.username}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <div className="room-empty">
            <p>Select a room to start chatting</p>
          </div>
        )}
      </div>

      {showCreateModal && (
        <div className="modal-overlay" onClick={() => setShowCreateModal(false)}>
          <div className="modal-content" onClick={(e) => e.stopPropagation()}>
            <h2>Create New Room</h2>
            <form onSubmit={handleCreateRoom}>
              <div className="form-group">
                <label>Post</label>
                <select
                  value={newRoom.post_id}
                  onChange={(e) => setNewRoom({ ...newRoom, post_id: e.target.value })}
                  required
                >
                  <option value="">Select a post</option>
                  {posts.map(post => (
                    <option key={post.id} value={post.id}>{post.title}</option>
                  ))}
                </select>
              </div>
              <div className="form-group">
                <label>Room Name</label>
                <input
                  type="text"
                  value={newRoom.name}
                  onChange={(e) => setNewRoom({ ...newRoom, name: e.target.value })}
                  placeholder="e.g. Study Group A"
                  required
                />
              </div>
              <div className="modal-actions">
                <button type="button" onClick={() => setShowCreateModal(false)} className="btn-cancel">
                  Cancel
                </button>
                <button type="submit" className="btn-submit">Create</button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}