# Server Configuration
PORT=5000
NODE_ENV=development

# Database. On Railway, point this at the volume, e.g. /data/helios.sqlite
DATABASE_URL=./database.sqlite

# Uploaded pictures and room files. Defaults to backend/uploads.
# On Railway, point this at the volume, e.g. /data/uploads
# UPLOAD_DIR=./uploads

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Groq API (for chatbot)
GROQ_API_KEY=your-groq-api-key-here

# Sites allowed to call the API and open live connections (comma-separated).
# In production, the address of the deployed frontend, e.g. https://helios.vercel.app
CORS_ORIGINS=http://localhost:5173

# Rate limiting: requests per address per window. In development GET requests are not counted;
# in production every request is, and one feed load makes several.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
